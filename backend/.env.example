# MongoDB Atlas Connection
# Set your actual MongoDB connection string (or leave empty to use built-in offline engine)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=expensepilot

# Optional LLM API Keys (Groq / Gemini / OpenAI for natural language agent)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mindee Document & Invoice OCR API
MINDEE_API_KEY=your_mindee_api_key_here
# Optional for Mindee V2: Model ID from your Mindee dashboard (https://app.mindee.com)
MINDEE_MODEL_ID=your_mindee_model_id_here
